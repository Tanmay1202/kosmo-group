# ==============================================================================
# KOSMO GROUP HUB - ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development. Never commit .env or real secrets.
# ==============================================================================

# Custom Domain Configuration
NEXT_PUBLIC_GROUP_DOMAIN="<GROUP_DOMAIN>"
NEXT_PUBLIC_SITE_URL="https://<GROUP_DOMAIN>"

# Lead Routing Notification Recipients (Comma-separated emails)
LEADS_TO_TATA="tata-leads@kosmogroup.in"
LEADS_TO_HERO="hero-leads@kosmogroup.in"
LEADS_TO_GENERAL="contact@kosmogroup.in"

# Resend Email Dispatch (Optional, falls back to server logging if absent)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Kosmo Group Leads <leads@kosmogroup.in>"

# Cloudflare Turnstile Spam Protection (Optional)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# Lead Persistence Datastore - Supabase (Optional, falls back to server logs)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Analytics (Google Analytics 4 / Tag Manager)
NEXT_PUBLIC_ANALYTICS_ID=""
